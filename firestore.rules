rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // 1. Global Safety Net (Default Deny)
    match /{document=**} {
      allow read, write: if false;
    }

    // =========================================================
    // Helper Primitives & Permission Model Mirror (src/lib/permissions.js)
    // =========================================================
    function isSignedIn() {
      return request.auth != null;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    function userExists() {
      return isSignedIn() && exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function callerData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function isApprovedActiveUser() {
      return userExists()
        && callerData().approvalStatus == 'approved'
        && callerData().status == 'active';
    }

    function isBootstrapSuperAdmin() {
      return isSignedIn()
        && request.auth.token.email in ['absiddik5177@gmail.com', 'absiddik517@gmail.com']
        && request.auth.token.email_verified == true;
    }

    // MIGRATION_COMPAT: legacy role mapping removed only after running scripts/migrate-roles.mjs
    function normalizeRole(r) {
      return r == 'head_office' ? 'director_general'
        : (r == 'district_officer' ? 'assistant_director'
        : (r == 'office_head' ? 'unfeo' : r));
    }

    function callerRole() {
      return isBootstrapSuperAdmin()
        ? 'super_admin'
        : (isApprovedActiveUser() ? normalizeRole(callerData().role) : '');
    }

    function rankOf(r) {
      return normalizeRole(r) == 'super_admin' ? 100
        : (normalizeRole(r) == 'director_general' ? 90
        : (normalizeRole(r) == 'head_office_officer' ? 80
        : (normalizeRole(r) == 'assistant_director' ? 60
        : (normalizeRole(r) == 'unfeo' ? 40
        : (normalizeRole(r) == 'employee' ? 10 : 0)))));
    }

    // Mirrors DEFAULT_PERMISSIONS in src/lib/permissions.js
    function defaultPermScope(perm) {
      return perm == 'attendance.checkin'
          ? (callerRole() in ['employee', 'unfeo', 'assistant_director', 'director_general', 'head_office_officer'] ? 'self' : '')
        : (perm == 'attendance.view'
          ? (callerRole() in ['super_admin', 'director_general', 'head_office_officer'] ? 'all'
            : (callerRole() == 'assistant_director' ? 'subtree'
            : (callerRole() == 'unfeo' ? 'office'
            : (callerRole() == 'employee' ? 'self' : ''))))
        : (perm == 'attendance.settle'
          ? (callerRole() == 'assistant_director' ? 'subtree' : '')
        : (perm == 'attendance.photo.view'
          ? (callerRole() == 'super_admin' ? 'all'
            : (callerRole() == 'assistant_director' ? 'subtree'
            : (callerRole() == 'unfeo' ? 'office' : '')))
        : (perm == 'attendance.photo.purge'
          ? (callerRole() == 'super_admin' ? 'all' : '')
        : (perm == 'leave.apply' || perm == 'fieldduty.apply'
          ? (callerRole() in ['employee', 'unfeo', 'assistant_director', 'director_general', 'head_office_officer'] ? 'self' : '')
        : (perm == 'leave.review'
          ? (callerRole() == 'director_general' ? 'all'
            : (callerRole() == 'assistant_director' ? 'subtree'
            : (callerRole() == 'unfeo' ? 'office' : '')))
        : (perm == 'fieldduty.review'
          ? (callerRole() == 'assistant_director' ? 'subtree' : '')
        : (perm == 'report.create'
          ? (callerRole() == 'assistant_director' ? 'subtree'
            : (callerRole() == 'unfeo' ? 'office' : ''))
        : (perm == 'report.view' || perm == 'user.view'
          ? (callerRole() in ['super_admin', 'director_general', 'head_office_officer'] ? 'all'
            : (callerRole() == 'assistant_director' ? 'subtree'
            : (callerRole() == 'unfeo' ? 'office' : '')))
        : (perm == 'user.approve' || perm == 'user.resetDevice'
          ? (callerRole() == 'super_admin' ? 'all'
            : (callerRole() == 'assistant_director' ? 'subtree'
            : (callerRole() == 'unfeo' ? 'office' : '')))
        : (perm == 'user.edit' || perm == 'user.role.assign'
          ? (callerRole() == 'super_admin' ? 'all'
            : (callerRole() == 'assistant_director' ? 'subtree' : ''))
        : (perm == 'user.delete' || perm == 'office.manage' || perm == 'holiday.manage' || perm == 'settings.manage'
          ? (callerRole() == 'super_admin' ? 'all' : '')
        : (perm == 'audit.view'
          ? (callerRole() in ['super_admin', 'director_general'] ? 'all'
            : (callerRole() == 'assistant_director' ? 'subtree' : ''))
        : '')))))))))))));
    }

    function permOverrideExists() {
      return exists(/databases/$(database)/documents/settings/permissions);
    }

    function permOverrideData() {
      return get(/databases/$(database)/documents/settings/permissions).data;
    }

    function hasOverrideScope(roleKey, perm) {
      return roleKey != ''
        && permOverrideExists()
        && 'overrides' in permOverrideData()
        && permOverrideData().overrides is map
        && roleKey in permOverrideData().overrides
        && permOverrideData().overrides[roleKey] is map
        && perm in permOverrideData().overrides[roleKey]
        && permOverrideData().overrides[roleKey][perm] is string;
    }

    function overrideScopeValue(roleKey, perm) {
      return permOverrideData().overrides[roleKey][perm];
    }

    function permScope(perm) {
      return hasOverrideScope(callerRole(), perm)
        ? (overrideScopeValue(callerRole(), perm) == 'none' ? '' : overrideScopeValue(callerRole(), perm))
        : defaultPermScope(perm);
    }

    function hasPerm(perm) {
      return permScope(perm) != '';
    }

    function docOfficeId(docData) {
      return 'officeId' in docData ? docData.officeId : '';
    }

    function docDistrictOfficeId(docData) {
      return 'districtOfficeId' in docData ? docData.districtOfficeId : '';
    }

    function inOfficeScope(val) {
      return val is string
        && val != ''
        && (
          val == callerData().officeId
          || (
            'additionalOfficeIds' in callerData()
            && callerData().additionalOfficeIds is list
            && val in callerData().additionalOfficeIds
          )
        );
    }

    function inSubtreeScope(officeVal, districtVal) {
      return inOfficeScope(officeVal) || inOfficeScope(districtVal);
    }

    function matchesDocScope(perm, uidVal, officeVal, districtVal) {
      return permScope(perm) == 'all'
        || (permScope(perm) == 'self' && uidVal == request.auth.uid)
        || (permScope(perm) == 'office' && inOfficeScope(officeVal))
        || (permScope(perm) == 'subtree' && inSubtreeScope(officeVal, districtVal));
    }

    function canReviewLeaveRole(applicantRole) {
      return rankOf(callerRole()) > rankOf(applicantRole)
        && (
          hasOverrideScope(callerRole(), 'leave.review')
          || (callerRole() == 'unfeo' && normalizeRole(applicantRole) == 'employee')
          || (callerRole() == 'assistant_director' && normalizeRole(applicantRole) in ['employee', 'unfeo'])
          || (callerRole() == 'director_general' && normalizeRole(applicantRole) == 'assistant_director')
        );
    }

    function registrationIsOpen() {
      return !exists(/databases/$(database)/documents/settings/app)
        || get(/databases/$(database)/documents/settings/app).data.registrationOpen == true;
    }

    function isOptString(val, maxLen) {
      return val == null || (val is string && val.size() <= maxLen);
    }

    function isOptTimestamp(val) {
      return val == null || val is timestamp;
    }

    function isValidDateStr(val) {
      return val is string && val.size() == 10 && val.matches('^\\d{4}-\\d{2}-\\d{2}$');
    }

    function isValidTimeStr(val) {
      return val is string && val.size() == 5 && val.matches('^([01]\\d|2[0-3]):[0-5]\\d$');
    }

    // =========================================================
    // Validation Blueprints
    // =========================================================
    function isValidSettings(data) {
      return data.keys().hasAll(['registrationOpen', 'updatedAt', 'updatedBy'])
        && data.keys().hasOnly(['registrationOpen', 'updatedAt', 'updatedBy'])
        && data.registrationOpen is bool
        && data.updatedAt is timestamp
        && data.updatedBy is string && data.updatedBy.size() <= 128;
    }

    function isValidPermRoleMap(roleMap) {
      return roleMap is map
        && roleMap.keys().hasOnly([
          'attendance.checkin', 'attendance.view', 'attendance.settle',
          'attendance.photo.view', 'attendance.photo.purge',
          'leave.apply', 'leave.review', 'fieldduty.apply', 'fieldduty.review',
          'report.create', 'report.view',
          'user.view', 'user.approve', 'user.resetDevice', 'user.edit', 'user.role.assign', 'user.delete',
          'office.manage', 'holiday.manage', 'settings.manage', 'audit.view'
        ])
        && roleMap.values().hasOnly(['none', 'self', 'office', 'subtree', 'all']);
    }

    function isValidPermissionConfig(data) {
      return data.keys().hasAll(['overrides', 'updatedAt', 'updatedBy'])
        && data.keys().hasOnly(['overrides', 'updatedAt', 'updatedBy', 'updatedByName'])
        && data.overrides is map
        && data.overrides.keys().hasOnly(['super_admin', 'director_general', 'head_office_officer', 'assistant_director', 'unfeo', 'employee'])
        && (!('super_admin' in data.overrides) || (
          isValidPermRoleMap(data.overrides.super_admin)
          && (!('settings.manage' in data.overrides.super_admin) || data.overrides.super_admin['settings.manage'] == 'all')
        ))
        && (!('director_general' in data.overrides) || isValidPermRoleMap(data.overrides.director_general))
        && (!('head_office_officer' in data.overrides) || isValidPermRoleMap(data.overrides.head_office_officer))
        && (!('assistant_director' in data.overrides) || isValidPermRoleMap(data.overrides.assistant_director))
        && (!('unfeo' in data.overrides) || isValidPermRoleMap(data.overrides.unfeo))
        && (!('employee' in data.overrides) || isValidPermRoleMap(data.overrides.employee))
        && data.updatedAt is timestamp
        && data.updatedBy is string && data.updatedBy.size() >= 1 && data.updatedBy.size() <= 128
        && (!('updatedByName' in data) || isOptString(data.updatedByName, 120));
    }

    function isValidOffice(data) {
      return data.keys().hasAll(['name', 'address', 'level', 'lat', 'lng', 'geofenceRadiusMeters', 'startTime', 'graceMinutes', 'endTime', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['name', 'address', 'level', 'parentOfficeId', 'lat', 'lng', 'geofenceRadiusMeters', 'startTime', 'graceMinutes', 'endTime', 'createdAt', 'updatedAt'])
        && data.name is string && data.name.size() >= 2 && data.name.size() <= 160
        && data.address is string && data.address.size() >= 2 && data.address.size() <= 300
        && data.level in ['head', 'district', 'upazila']
        && (!('parentOfficeId' in data) || isOptString(data.parentOfficeId, 128))
        && data.lat is number && data.lat >= -90 && data.lat <= 90
        && data.lng is number && data.lng >= -180 && data.lng <= 180
        && data.geofenceRadiusMeters is number && data.geofenceRadiusMeters >= 10 && data.geofenceRadiusMeters <= 50000
        && isValidTimeStr(data.startTime)
        && data.graceMinutes is number && data.graceMinutes >= 0 && data.graceMinutes <= 180
        && isValidTimeStr(data.endTime)
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isOptAdditionalOfficeIds(data) {
      return !('additionalOfficeIds' in data)
        || data.additionalOfficeIds == null
        || (
          data.additionalOfficeIds is list
          && data.additionalOfficeIds.size() <= 20
          && (
            data.additionalOfficeIds.size() == 0
            || (
              data.additionalOfficeIds[0] is string
              && data.additionalOfficeIds[0].size() >= 1
              && data.additionalOfficeIds[0].size() <= 128
            )
          )
        );
    }

    function isValidUser(data) {
      return data.keys().hasAll(['status', 'role', 'approvalStatus', 'updatedAt'])
        && data.keys().hasOnly(['uid', 'name', 'designation', 'address', 'mobile', 'email', 'officeId', 'districtOfficeId', 'additionalOfficeIds', 'joiningDate', 'status', 'resignationDate', 'profilePhotoPath', 'role', 'approvalStatus', 'boundDeviceId', 'createdAt', 'updatedAt'])
        && (!('uid' in data) || isOptString(data.uid, 128))
        && (!('name' in data) || isOptString(data.name, 120))
        && (!('designation' in data) || isOptString(data.designation, 120))
        && (!('address' in data) || isOptString(data.address, 300))
        && (!('mobile' in data) || isOptString(data.mobile, 30))
        && (!('email' in data) || isOptString(data.email, 160))
        && (!('officeId' in data) || isOptString(data.officeId, 128))
        && (!('districtOfficeId' in data) || isOptString(data.districtOfficeId, 128))
        && isOptAdditionalOfficeIds(data)
        && (!('joiningDate' in data) || data.joiningDate == null || data.joiningDate == '' || data.joiningDate is timestamp || isValidDateStr(data.joiningDate))
        && data.status in ['active', 'resigned']
        && (!('resignationDate' in data) || data.resignationDate == null || data.resignationDate == '' || data.resignationDate is timestamp || isValidDateStr(data.resignationDate))
        && (!('profilePhotoPath' in data) || isOptString(data.profilePhotoPath, 300))
        // MIGRATION_COMPAT: accept legacy role strings until migration script completes
        && data.role in ['employee', 'unfeo', 'assistant_director', 'head_office_officer', 'director_general', 'super_admin', 'office_head', 'district_officer', 'head_office']
        && data.approvalStatus in ['pending', 'approved', 'rejected']
        && (!('boundDeviceId' in data) || isOptString(data.boundDeviceId, 128))
        && (!('createdAt' in data) || data.createdAt == null || data.createdAt is timestamp)
        && data.updatedAt is timestamp;
    }

    function isCompleteUserCreate(data) {
      return isValidUser(data)
        && data.keys().hasAll(['uid', 'name', 'designation', 'address', 'mobile', 'email', 'officeId', 'joiningDate', 'status', 'role', 'approvalStatus', 'createdAt', 'updatedAt'])
        && data.uid is string && data.uid.size() >= 1 && data.uid.size() <= 128
        && data.name is string && data.name.size() >= 2 && data.name.size() <= 120
        && data.designation is string && data.designation.size() >= 2 && data.designation.size() <= 120
        && data.address is string && data.address.size() >= 2 && data.address.size() <= 300
        && data.mobile is string && data.mobile.size() >= 6 && data.mobile.size() <= 30
        && data.email is string && data.email.size() >= 5 && data.email.size() <= 160
        && isValidDateStr(data.joiningDate);
    }

    function isValidPunch(punch) {
      return punch is map
        && punch.keys().hasAll(['time', 'lat', 'lng', 'accuracy', 'distanceMeters', 'deviceId', 'photoPath', 'photoDeleted'])
        && punch.keys().hasOnly(['time', 'lat', 'lng', 'accuracy', 'distanceMeters', 'deviceId', 'photoPath', 'photoDeleted', 'photoDeletedAt'])
        && punch.time is timestamp
        && punch.lat is number && punch.lat >= -90 && punch.lat <= 90
        && punch.lng is number && punch.lng >= -180 && punch.lng <= 180
        && punch.accuracy is number && punch.accuracy >= 0 && punch.accuracy <= 50
        && punch.distanceMeters is number && punch.distanceMeters >= 0
        && punch.deviceId is string && punch.deviceId.size() >= 4 && punch.deviceId.size() <= 128
        && punch.photoPath is string && punch.photoPath.size() >= 5 && punch.photoPath.size() <= 300
        && punch.photoDeleted is bool
        && (!('photoDeletedAt' in punch) || isOptTimestamp(punch.photoDeletedAt));
    }

    function isValidAttendance(data) {
      return data.keys().hasAll(['uid', 'employeeName', 'officeId', 'date', 'initialStatus', 'settled', 'photoDeleted', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['uid', 'employeeName', 'designation', 'officeId', 'districtOfficeId', 'date', 'isFieldDuty', 'checkIn', 'checkOut', 'initialStatus', 'finalStatus', 'settled', 'settledBy', 'settledByName', 'settledAt', 'districtComment', 'photoDeleted', 'photoDeletedAt', 'createdAt', 'updatedAt'])
        && data.uid is string && data.uid.size() >= 1 && data.uid.size() <= 128
        && data.employeeName is string && data.employeeName.size() >= 1 && data.employeeName.size() <= 120
        && (!('designation' in data) || isOptString(data.designation, 120))
        && data.officeId is string && data.officeId.size() >= 1 && data.officeId.size() <= 128
        && (!('districtOfficeId' in data) || isOptString(data.districtOfficeId, 128))
        && isValidDateStr(data.date)
        && (!('isFieldDuty' in data) || data.isFieldDuty is bool)
        && (!('checkIn' in data) || data.checkIn == null || isValidPunch(data.checkIn))
        && (!('checkOut' in data) || data.checkOut == null || isValidPunch(data.checkOut))
        && data.initialStatus in ['সময়মতো', 'বিলম্বিত', 'Absent (প্রস্তাবিত)']
        && (!('finalStatus' in data) || data.finalStatus == null || data.finalStatus in ['On Time', 'Late', 'Leave', 'Absent'])
        && data.settled is bool
        && (!('settledBy' in data) || isOptString(data.settledBy, 128))
        && (!('settledByName' in data) || isOptString(data.settledByName, 120))
        && (!('settledAt' in data) || isOptTimestamp(data.settledAt))
        && (!('districtComment' in data) || isOptString(data.districtComment, 500))
        && data.photoDeleted is bool
        && (!('photoDeletedAt' in data) || isOptTimestamp(data.photoDeletedAt))
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidSettlement(data) {
      return data.keys().hasAll(['attendanceId', 'employeeUid', 'employeeName', 'officeId', 'date', 'newStatus', 'settledBy', 'settledByName', 'settledAt'])
        && data.keys().hasOnly(['attendanceId', 'employeeUid', 'employeeName', 'officeId', 'districtOfficeId', 'date', 'oldStatus', 'newStatus', 'comment', 'reason', 'settledBy', 'settledByName', 'settledAt'])
        && data.attendanceId is string && data.attendanceId.size() >= 1 && data.attendanceId.size() <= 180
        && data.employeeUid is string && data.employeeUid.size() >= 1 && data.employeeUid.size() <= 128
        && data.employeeName is string && data.employeeName.size() >= 1 && data.employeeName.size() <= 120
        && data.officeId is string && data.officeId.size() >= 1 && data.officeId.size() <= 128
        && (!('districtOfficeId' in data) || isOptString(data.districtOfficeId, 128))
        && isValidDateStr(data.date)
        && (!('oldStatus' in data) || isOptString(data.oldStatus, 60))
        && data.newStatus in ['On Time', 'Late', 'Leave', 'Absent']
        && (!('comment' in data) || isOptString(data.comment, 500))
        && (!('reason' in data) || isOptString(data.reason, 500))
        && data.settledBy is string && data.settledBy.size() >= 1 && data.settledBy.size() <= 128
        && data.settledByName is string && data.settledByName.size() >= 1 && data.settledByName.size() <= 120
        && data.settledAt is timestamp;
    }

    function isValidLeave(data) {
      return data.keys().hasAll(['uid', 'employeeName', 'officeId', 'startDate', 'endDate', 'leaveType', 'reason', 'status', 'createdAt'])
        && data.keys().hasOnly(['uid', 'employeeName', 'officeId', 'districtOfficeId', 'startDate', 'endDate', 'leaveType', 'reason', 'status', 'reviewedBy', 'reviewedByName', 'reviewComment', 'reviewedAt', 'createdAt'])
        && data.uid is string && data.uid.size() >= 1 && data.uid.size() <= 128
        && data.employeeName is string && data.employeeName.size() >= 1 && data.employeeName.size() <= 120
        && data.officeId is string && data.officeId.size() >= 1 && data.officeId.size() <= 128
        && (!('districtOfficeId' in data) || isOptString(data.districtOfficeId, 128))
        && isValidDateStr(data.startDate)
        && isValidDateStr(data.endDate)
        && data.leaveType is string && data.leaveType.size() >= 2 && data.leaveType.size() <= 60
        && data.reason is string && data.reason.size() >= 2 && data.reason.size() <= 500
        && data.status in ['pending', 'approved', 'rejected']
        && (!('reviewedBy' in data) || isOptString(data.reviewedBy, 128))
        && (!('reviewedByName' in data) || isOptString(data.reviewedByName, 120))
        && (!('reviewComment' in data) || isOptString(data.reviewComment, 500))
        && (!('reviewedAt' in data) || isOptTimestamp(data.reviewedAt))
        && data.createdAt is timestamp;
    }

    function isValidFieldDuty(data) {
      return data.keys().hasAll(['uid', 'employeeName', 'officeId', 'startDate', 'endDate', 'location', 'reason', 'status', 'createdAt'])
        && data.keys().hasOnly(['uid', 'employeeName', 'officeId', 'districtOfficeId', 'startDate', 'endDate', 'location', 'reason', 'status', 'reviewedBy', 'reviewedByName', 'reviewComment', 'reviewedAt', 'createdAt'])
        && data.uid is string && data.uid.size() >= 1 && data.uid.size() <= 128
        && data.employeeName is string && data.employeeName.size() >= 1 && data.employeeName.size() <= 120
        && data.officeId is string && data.officeId.size() >= 1 && data.officeId.size() <= 128
        && (!('districtOfficeId' in data) || isOptString(data.districtOfficeId, 128))
        && isValidDateStr(data.startDate)
        && isValidDateStr(data.endDate)
        && data.location is string && data.location.size() >= 2 && data.location.size() <= 200
        && data.reason is string && data.reason.size() >= 2 && data.reason.size() <= 500
        && data.status in ['pending', 'approved', 'rejected']
        && (!('reviewedBy' in data) || isOptString(data.reviewedBy, 128))
        && (!('reviewedByName' in data) || isOptString(data.reviewedByName, 120))
        && (!('reviewComment' in data) || isOptString(data.reviewComment, 500))
        && (!('reviewedAt' in data) || isOptTimestamp(data.reviewedAt))
        && data.createdAt is timestamp;
    }

    function isValidHoliday(data) {
      return data.keys().hasAll(['date', 'title', 'type', 'createdBy', 'createdAt'])
        && data.keys().hasOnly(['date', 'title', 'type', 'createdBy', 'createdAt'])
        && isValidDateStr(data.date)
        && data.title is string && data.title.size() >= 2 && data.title.size() <= 160
        && data.type in ['government', 'national', 'optional']
        && data.createdBy is string && data.createdBy.size() >= 1 && data.createdBy.size() <= 128
        && data.createdAt is timestamp;
    }

    function isValidReport(data) {
      return data.keys().hasAll(['officeId', 'officeName', 'month', 'generatedBy', 'generatedByName', 'submittedAt', 'summary', 'rows'])
        && data.keys().hasOnly(['officeId', 'officeName', 'districtOfficeId', 'month', 'generatedBy', 'generatedByName', 'submittedAt', 'summary', 'rows'])
        && data.officeId is string && data.officeId.size() >= 1 && data.officeId.size() <= 128
        && data.officeName is string && data.officeName.size() >= 1 && data.officeName.size() <= 160
        && (!('districtOfficeId' in data) || isOptString(data.districtOfficeId, 128))
        && data.month is string && data.month.size() == 7 && data.month.matches('^\\d{4}-\\d{2}$')
        && data.generatedBy is string && data.generatedBy.size() >= 1 && data.generatedBy.size() <= 128
        && data.generatedByName is string && data.generatedByName.size() >= 1 && data.generatedByName.size() <= 120
        && data.submittedAt is timestamp
        && data.summary is map
        && data.rows is list && data.rows.size() <= 500;
    }

    function isValidAuditLog(data) {
      return data.keys().hasAll(['actorUid', 'actorName', 'actorRole', 'action', 'targetCollection', 'targetId', 'reason', 'timestamp'])
        && data.keys().hasOnly(['actorUid', 'actorName', 'actorRole', 'officeId', 'districtOfficeId', 'action', 'targetCollection', 'targetId', 'oldValue', 'newValue', 'reason', 'timestamp'])
        && data.actorUid is string && data.actorUid.size() >= 1 && data.actorUid.size() <= 128
        && data.actorName is string && data.actorName.size() >= 1 && data.actorName.size() <= 120
        && data.actorRole is string && data.actorRole.size() >= 1 && data.actorRole.size() <= 40
        && (!('officeId' in data) || isOptString(data.officeId, 128))
        && (!('districtOfficeId' in data) || isOptString(data.districtOfficeId, 128))
        && data.action is string && data.action.size() >= 2 && data.action.size() <= 80
        && data.targetCollection is string && data.targetCollection.size() >= 2 && data.targetCollection.size() <= 60
        && data.targetId is string && data.targetId.size() >= 1 && data.targetId.size() <= 180
        && (!('oldValue' in data) || isOptString(data.oldValue, 500))
        && (!('newValue' in data) || isOptString(data.newValue, 500))
        && data.reason is string && data.reason.size() <= 500
        && data.timestamp is timestamp;
    }

    // =========================================================
    // Collection Rules
    // =========================================================

    // Settings: settings/app (public registrationOpen) & settings/permissions (live role permission overrides)
    match /settings/{settingId} {
      allow get: if isValidId(settingId) && (
        settingId == 'app'
        || (settingId == 'permissions' && isSignedIn())
      );
      allow create, update: if isValidId(settingId) && (
        (
          settingId == 'app'
          && hasPerm('settings.manage')
          && isValidSettings(incoming())
          && incoming().updatedAt == request.time
          && incoming().updatedBy == request.auth.uid
        )
        || (
          settingId == 'permissions'
          && callerRole() == 'super_admin'
          && hasPerm('settings.manage')
          && isValidPermissionConfig(incoming())
          && incoming().updatedAt == request.time
          && incoming().updatedBy == request.auth.uid
        )
      );
      allow delete: if false;
    }

    // Offices: public read (non-PII office directory); office.manage writes
    match /offices/{officeId} {
      allow get: if isValidId(officeId);
      allow list: if resource.data.level in ['head', 'district', 'upazila'];
      allow create: if isValidId(officeId)
        && hasPerm('office.manage')
        && isValidOffice(incoming())
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isValidId(officeId)
        && hasPerm('office.manage')
        && isValidOffice(incoming())
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time;
      allow delete: if isValidId(officeId) && hasPerm('office.manage');
    }

    // Users: strict PII protection, scoped visibility & hierarchy updates
    match /users/{userId} {
      allow get: if isValidId(userId) && isSignedIn() && (
        isOwner(userId)
        || (hasPerm('user.view') && matchesDocScope('user.view', userId, docOfficeId(existing()), docDistrictOfficeId(existing())))
      );

      allow list: if isSignedIn() && (
        resource.data.uid == request.auth.uid
        || (hasPerm('user.view') && matchesDocScope('user.view', resource.data.uid, docOfficeId(resource.data), docDistrictOfficeId(resource.data)))
      );

      allow create: if isValidId(userId)
        && isSignedIn()
        && incoming().uid == userId
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time
        && (
          (
            permScope('user.edit') == 'all'
            && isValidUser(incoming())
          )
          || (
            isOwner(userId)
            && isCompleteUserCreate(incoming())
            && registrationIsOpen()
            && incoming().role == 'employee'
            && incoming().approvalStatus == 'pending'
            && (!('boundDeviceId' in incoming()) || incoming().boundDeviceId == null)
          )
        );

      allow update: if isValidId(userId)
        && isSignedIn()
        && incoming().updatedAt == request.time
        && (
          // Owner first-time device binding (or idempotent retry with identical deviceId)
          (
            isOwner(userId)
            && isApprovedActiveUser()
            && (
              !('boundDeviceId' in existing())
              || existing().boundDeviceId == null
              || existing().boundDeviceId == ''
              || existing().boundDeviceId == incoming().boundDeviceId
            )
            && incoming().boundDeviceId is string
            && incoming().boundDeviceId.size() >= 4
            && incoming().boundDeviceId.size() <= 128
            && incoming().diff(existing()).affectedKeys().hasOnly(['boundDeviceId', 'updatedAt'])
          )
          // Owner profile photo update
          || (
            isOwner(userId)
            && (!('profilePhotoPath' in incoming()) || isOptString(incoming().profilePhotoPath, 300))
            && incoming().diff(existing()).affectedKeys().hasOnly(['profilePhotoPath', 'updatedAt'])
          )
          // Scoped admin/manager updates validate full user schema & immutable identity fields
          || (
            isValidUser(incoming())
            && (!('uid' in existing()) || incoming().uid == existing().uid)
            && (!('createdAt' in existing()) || incoming().createdAt == existing().createdAt)
            && (
              // Super Admin (all scope) — blocked from demoting own super_admin role
              (
                permScope('user.edit') == 'all'
                && !(isOwner(userId) && normalizeRole(existing().role) == 'super_admin' && normalizeRole(incoming().role) != 'super_admin')
              )
              // Assistant Director (subtree scope): edit lower-rank user profile, approve, reset device, assign strictly lower role
              || (
                hasPerm('user.edit')
                && permScope('user.edit') == 'subtree'
                && userId != request.auth.uid
                && matchesDocScope('user.edit', userId, docOfficeId(existing()), docDistrictOfficeId(existing()))
                && matchesDocScope('user.edit', userId, docOfficeId(incoming()), docDistrictOfficeId(incoming()))
                && rankOf(callerRole()) > rankOf(existing().role)
                && (
                  normalizeRole(incoming().role) == normalizeRole(existing().role)
                  || (hasPerm('user.role.assign') && rankOf(callerRole()) > rankOf(incoming().role))
                )
                && (!('boundDeviceId' in incoming().diff(existing()).affectedKeys()) || incoming().boundDeviceId == null)
                && incoming().diff(existing()).affectedKeys().hasOnly(['approvalStatus', 'boundDeviceId', 'name', 'designation', 'mobile', 'address', 'officeId', 'districtOfficeId', 'joiningDate', 'role', 'status', 'resignationDate', 'updatedAt'])
              )
              // UNFEO (office scope): approve or reset device for lower-rank staff (employee) in own office(s)
              || (
                hasPerm('user.approve')
                && permScope('user.approve') == 'office'
                && userId != request.auth.uid
                && matchesDocScope('user.approve', userId, docOfficeId(existing()), docDistrictOfficeId(existing()))
                && rankOf(callerRole()) > rankOf(existing().role)
                && (!('boundDeviceId' in incoming().diff(existing()).affectedKeys()) || incoming().boundDeviceId == null)
                && incoming().diff(existing()).affectedKeys().hasOnly(['approvalStatus', 'boundDeviceId', 'updatedAt'])
              )
            )
          )
        );

      // Last Super Admin protection: no super_admin document can be deleted via client rules
      allow delete: if isValidId(userId)
        && hasPerm('user.delete')
        && userId != request.auth.uid
        && normalizeRole(existing().role) != 'super_admin';
    }

    // Attendance: keyed as {uid}_{yyyy-mm-dd}, server timestamps enforced
    match /attendance/{attendanceId} {
      allow get: if isValidId(attendanceId) && isSignedIn() && (
        (resource == null && attendanceId.matches('^' + request.auth.uid + '_\\d{4}-\\d{2}-\\d{2}$'))
        || (resource != null && (
          existing().uid == request.auth.uid
          || (hasPerm('attendance.view') && matchesDocScope('attendance.view', existing().uid, docOfficeId(existing()), docDistrictOfficeId(existing())))
        ))
      );

      allow list: if isSignedIn() && (
        resource.data.uid == request.auth.uid
        || (hasPerm('attendance.view') && matchesDocScope('attendance.view', resource.data.uid, docOfficeId(resource.data), docDistrictOfficeId(resource.data)))
      );

      allow create: if isValidId(attendanceId)
        && isApprovedActiveUser()
        && isValidAttendance(incoming())
        && attendanceId == (incoming().uid + '_' + incoming().date)
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time
        && exists(/databases/$(database)/documents/users/$(incoming().uid))
        && exists(/databases/$(database)/documents/offices/$(incoming().officeId))
        && (
          // Self daily check-in (denied for super_admin via attendance.checkin grant)
          (
            hasPerm('attendance.checkin')
            && isOwner(incoming().uid)
            && incoming().checkIn != null
            && 'boundDeviceId' in callerData()
            && callerData().boundDeviceId is string
            && incoming().checkIn.deviceId == callerData().boundDeviceId
            && (!('checkOut' in incoming()) || incoming().checkOut == null)
            && incoming().settled == false
            && (!('finalStatus' in incoming()) || incoming().finalStatus == null)
          )
          // Assistant Director settling a proposed absent date (never self, strictly lower rank)
          || (
            hasPerm('attendance.settle')
            && incoming().uid != request.auth.uid
            && matchesDocScope('attendance.settle', incoming().uid, docOfficeId(incoming()), docDistrictOfficeId(incoming()))
            && rankOf(callerRole()) > rankOf(get(/databases/$(database)/documents/users/$(incoming().uid)).data.role)
            && incoming().settled == true
            && incoming().finalStatus in ['On Time', 'Late', 'Leave', 'Absent']
            && incoming().settledBy == request.auth.uid
            && incoming().settledAt == request.time
          )
        );

      allow update: if isValidId(attendanceId)
        && isApprovedActiveUser()
        && isValidAttendance(incoming())
        && incoming().uid == existing().uid
        && incoming().officeId == existing().officeId
        && incoming().date == existing().date
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && (
          // Self same-day check-out
          (
            hasPerm('attendance.checkin')
            && isOwner(existing().uid)
            && existing().checkIn != null
            && (!('checkOut' in existing()) || existing().checkOut == null)
            && incoming().checkOut != null
            && 'boundDeviceId' in callerData()
            && callerData().boundDeviceId is string
            && incoming().checkOut.deviceId == callerData().boundDeviceId
            && incoming().diff(existing()).affectedKeys().hasOnly(['checkOut', 'updatedAt'])
          )
          // Assistant Director settlement + photoDeleted marking (never self, strictly lower rank)
          || (
            hasPerm('attendance.settle')
            && existing().uid != request.auth.uid
            && matchesDocScope('attendance.settle', existing().uid, docOfficeId(existing()), docDistrictOfficeId(existing()))
            && exists(/databases/$(database)/documents/users/$(existing().uid))
            && rankOf(callerRole()) > rankOf(get(/databases/$(database)/documents/users/$(existing().uid)).data.role)
            && incoming().settledBy == request.auth.uid
            && incoming().diff(existing()).affectedKeys().hasOnly(['finalStatus', 'settled', 'settledBy', 'settledByName', 'settledAt', 'districtComment', 'photoDeleted', 'photoDeletedAt', 'checkIn', 'checkOut', 'updatedAt'])
          )
          // Super Admin 15-day photo purge
          || (
            hasPerm('attendance.photo.purge')
            && incoming().photoDeleted == true
            && incoming().diff(existing()).affectedKeys().hasOnly(['photoDeleted', 'photoDeletedAt', 'checkIn', 'checkOut', 'updatedAt'])
          )
        );

      allow delete: if false;
    }

    // Settlements: immutable record per settlement action
    match /settlements/{settlementId} {
      allow get: if isValidId(settlementId) && isSignedIn() && (
        existing().employeeUid == request.auth.uid
        || (hasPerm('attendance.view') && permScope('attendance.view') == 'all')
        || (hasPerm('attendance.settle') && matchesDocScope('attendance.settle', existing().employeeUid, docOfficeId(existing()), docDistrictOfficeId(existing())))
      );

      allow list: if isSignedIn() && (
        resource.data.employeeUid == request.auth.uid
        || (hasPerm('attendance.view') && permScope('attendance.view') == 'all')
        || (hasPerm('attendance.settle') && matchesDocScope('attendance.settle', resource.data.employeeUid, docOfficeId(resource.data), docDistrictOfficeId(resource.data)))
      );

      allow create: if isValidId(settlementId)
        && hasPerm('attendance.settle')
        && isValidSettlement(incoming())
        && incoming().employeeUid != request.auth.uid
        && matchesDocScope('attendance.settle', incoming().employeeUid, docOfficeId(incoming()), docDistrictOfficeId(incoming()))
        && exists(/databases/$(database)/documents/users/$(incoming().employeeUid))
        && rankOf(callerRole()) > rankOf(get(/databases/$(database)/documents/users/$(incoming().employeeUid)).data.role)
        && incoming().settledBy == request.auth.uid
        && incoming().settledAt == request.time;

      allow update, delete: if false;
    }

    // Leaves: Approval chain (employee -> UNFEO/AD; UNFEO -> AD; AD -> DG), never self
    match /leaves/{leaveId} {
      allow get: if isValidId(leaveId) && isSignedIn() && (
        existing().uid == request.auth.uid
        || (hasPerm('attendance.view') && matchesDocScope('attendance.view', existing().uid, docOfficeId(existing()), docDistrictOfficeId(existing())))
        || (hasPerm('leave.review') && matchesDocScope('leave.review', existing().uid, docOfficeId(existing()), docDistrictOfficeId(existing())))
      );

      allow list: if isSignedIn() && (
        resource.data.uid == request.auth.uid
        || (hasPerm('attendance.view') && matchesDocScope('attendance.view', resource.data.uid, docOfficeId(resource.data), docDistrictOfficeId(resource.data)))
        || (hasPerm('leave.review') && matchesDocScope('leave.review', resource.data.uid, docOfficeId(resource.data), docDistrictOfficeId(resource.data)))
      );

      allow create: if isValidId(leaveId)
        && hasPerm('leave.apply')
        && isValidLeave(incoming())
        && isOwner(incoming().uid)
        && incoming().status == 'pending'
        && (!('reviewedBy' in incoming()) || incoming().reviewedBy == null)
        && (!('reviewedAt' in incoming()) || incoming().reviewedAt == null)
        && incoming().createdAt == request.time;

      allow update: if isValidId(leaveId)
        && hasPerm('leave.review')
        && isValidLeave(incoming())
        && matchesDocScope('leave.review', existing().uid, docOfficeId(existing()), docDistrictOfficeId(existing()))
        && existing().uid != request.auth.uid
        && exists(/databases/$(database)/documents/users/$(existing().uid))
        && canReviewLeaveRole(get(/databases/$(database)/documents/users/$(existing().uid)).data.role)
        && existing().status == 'pending'
        && incoming().status in ['approved', 'rejected']
        && incoming().reviewedBy == request.auth.uid
        && incoming().reviewedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly(['status', 'reviewedBy', 'reviewedByName', 'reviewComment', 'reviewedAt']);

      allow delete: if false;
    }

    // Field Duties: Reviewed strictly by higher-rank reviewer with fieldduty.review (never self)
    match /fieldDuties/{fieldDutyId} {
      allow get: if isValidId(fieldDutyId) && isSignedIn() && (
        existing().uid == request.auth.uid
        || (hasPerm('attendance.view') && matchesDocScope('attendance.view', existing().uid, docOfficeId(existing()), docDistrictOfficeId(existing())))
        || (hasPerm('fieldduty.review') && matchesDocScope('fieldduty.review', existing().uid, docOfficeId(existing()), docDistrictOfficeId(existing())))
      );

      allow list: if isSignedIn() && (
        resource.data.uid == request.auth.uid
        || (hasPerm('attendance.view') && matchesDocScope('attendance.view', resource.data.uid, docOfficeId(resource.data), docDistrictOfficeId(resource.data)))
        || (hasPerm('fieldduty.review') && matchesDocScope('fieldduty.review', resource.data.uid, docOfficeId(resource.data), docDistrictOfficeId(resource.data)))
      );

      allow create: if isValidId(fieldDutyId)
        && hasPerm('fieldduty.apply')
        && isValidFieldDuty(incoming())
        && isOwner(incoming().uid)
        && incoming().status == 'pending'
        && (!('reviewedBy' in incoming()) || incoming().reviewedBy == null)
        && (!('reviewedAt' in incoming()) || incoming().reviewedAt == null)
        && incoming().createdAt == request.time;

      allow update: if isValidId(fieldDutyId)
        && hasPerm('fieldduty.review')
        && isValidFieldDuty(incoming())
        && matchesDocScope('fieldduty.review', existing().uid, docOfficeId(existing()), docDistrictOfficeId(existing()))
        && existing().uid != request.auth.uid
        && exists(/databases/$(database)/documents/users/$(existing().uid))
        && rankOf(callerRole()) > rankOf(get(/databases/$(database)/documents/users/$(existing().uid)).data.role)
        && (
          hasOverrideScope(callerRole(), 'fieldduty.review')
          || normalizeRole(get(/databases/$(database)/documents/users/$(existing().uid)).data.role) in ['employee', 'unfeo']
        )
        && existing().status == 'pending'
        && incoming().status in ['approved', 'rejected']
        && incoming().reviewedBy == request.auth.uid
        && incoming().reviewedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly(['status', 'reviewedBy', 'reviewedByName', 'reviewComment', 'reviewedAt']);

      allow delete: if false;
    }

    // Holidays: signed-in read, holiday.manage writes
    match /holidays/{holidayId} {
      allow get: if isValidId(holidayId) && isSignedIn();
      allow list: if isSignedIn() && resource.data.type in ['government', 'national', 'optional'];
      allow create, update: if isValidId(holidayId)
        && hasPerm('holiday.manage')
        && isValidHoliday(incoming())
        && incoming().createdBy == request.auth.uid
        && incoming().createdAt == request.time;
      allow delete: if isValidId(holidayId) && hasPerm('holiday.manage');
    }

    // Reports: report.create (UNFEO office / AD subtree), report.view (UNFEO/AD/HO/DG/SuperAdmin)
    match /reports/{reportId} {
      allow get: if isValidId(reportId)
        && isSignedIn()
        && hasPerm('report.view')
        && matchesDocScope('report.view', '', docOfficeId(existing()), docDistrictOfficeId(existing()));

      allow list: if isSignedIn()
        && hasPerm('report.view')
        && matchesDocScope('report.view', '', docOfficeId(resource.data), docDistrictOfficeId(resource.data));

      allow create: if isValidId(reportId)
        && hasPerm('report.create')
        && isValidReport(incoming())
        && matchesDocScope('report.create', '', docOfficeId(incoming()), docDistrictOfficeId(incoming()))
        && incoming().generatedBy == request.auth.uid
        && incoming().submittedAt == request.time;

      allow update, delete: if false;
    }

    // Audit Logs: strictly append-only; readable per audit.view (SuperAdmin all, DG all, AD subtree)
    match /auditLogs/{logId} {
      allow get: if isValidId(logId)
        && isSignedIn()
        && hasPerm('audit.view')
        && matchesDocScope('audit.view', '', docOfficeId(existing()), docDistrictOfficeId(existing()));

      allow list: if isSignedIn()
        && hasPerm('audit.view')
        && matchesDocScope('audit.view', '', docOfficeId(resource.data), docDistrictOfficeId(resource.data));

      allow create: if isValidId(logId)
        && (isApprovedActiveUser() || isBootstrapSuperAdmin())
        && isValidAuditLog(incoming())
        && incoming().actorUid == request.auth.uid
        && incoming().timestamp == request.time;

      allow update, delete: if false;
    }
  }
}
